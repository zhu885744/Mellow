# Vite环境变量必须顶格写，注释单独行，值无需加单引号（Vite会自动解析）
# ============================================================
# ⚠️ 部署说明：
#   .env 已被 .gitignore 忽略，不会进入版本库。
#   生产环境构建/运行时必须自行放置一份 .env（可复制本文件改名），
#   否则 VITE_API_URI 为空，表情图片等后端静态资源会拼成相对前端域名而 404。
# ============================================================
VITE_TITLE = 朱某的生活印记
# 后端API地址（前端所有 /api 请求、表情图片 /assets 都基于它）
VITE_API_URI = https://cs.zhuxu.asia
VITE_SOCKET  = wss://cs.zhuxu.asia/socket
# API密钥（未开启则留空）
VITE_API_KEY =
# 外部库脚本注入（按需填写，默认空）
VITE_LIBS =
# 程序版本号
VITE_VERSION = 1.0.0
# 路由模式 history|hash
VITE_ROUTER_MODE = history
# Vite基础路径（部署子目录时改，例如 /mellow/）
VITE_BASE_URL = /
# Token存储的Cookie名称
VITE_TOKEN_NAME = INIS_LOGIN_TOKEN
# 通用交互延迟（毫秒）
VITE_LAZY_TIME = 500
VITE_AES_KEY=your_32byte_aes_key_here
VITE_AES_IV=your_16byte_iv_here
VITE_CRYPTO_SALT=your_salt_value
